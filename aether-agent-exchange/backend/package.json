{
  "name": "aether-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Aether Agent Exchange — Backend API",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "worker": "node dist/worker.js",
    "worker:dev": "tsx watch src/worker.ts",
    "workspace:provision": "tsx src/cli/provision-workspace.ts",
    "db:runtime-schema": "node scripts/generate-runtime-prisma-schema.mjs",
    "db:validate:runtime": "npm run db:runtime-schema -- prisma/schema.runtime.prisma && prisma validate --schema prisma/schema.runtime.prisma",
    "db:migrate:deploy": "npm run db:runtime-schema -- prisma/schema.runtime.prisma && prisma migrate deploy --schema prisma/schema.runtime.prisma",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:reset": "rm -f prisma/dev.db && prisma db push && tsx prisma/seed.ts",
    "test:backend": "tsx test-env/test-backend.ts",
    "test:integration": "tsx test-env/test-frontend-api.ts",
    "test:px402": "tsx test-env/test-px402-dry-run.ts",
    "test:simulate": "tsx test-env/simulate.ts",
    "test:invariants": "tsx test-env/run-all.ts --only-invariants",
    "test:all": "tsx test-env/run-all.ts"
  },
  "dependencies": {
    "@gitlawb/gl": "^0.3.7",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.5.0",
    "redis": "^4.7.1",
    "siwe": "^3.0.0",
    "uuid": "^11.1.0",
    "viem": "^2.54.1",
    "ws": "^8.21.0",
    "zod": "^3.24.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.13.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3"
  }
}
