DATABASE_URL="postgresql://user:password@localhost:5432/aae"
JWT_SECRET="change-me-to-a-random-64-char-secret"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Redis (optional — omit or leave empty to use in-memory stores)
# REDIS_URL=redis://localhost:6379

# Rate limit overrides (requests per minute per tier)
# RATE_LIMIT_AUTH=20
# RATE_LIMIT_USER=120
# RATE_LIMIT_AGENT=60
# RATE_LIMIT_WRITE=30
# RATE_LIMIT_NONCE=10

# Active public chain metadata. Supported: base, base-sepolia, ethereum, ethereum-sepolia, monad, monad-testnet, robinhood, robinhood-testnet.
# Production should set the intended live chain explicitly.
AAE_ACTIVE_CHAIN=base

# Base mainnet (chain ID 8453, ETH gas token).
BASE_RPC_URL=https://mainnet.base.org
BASE_EXPLORER_URL=https://basescan.org
AAE_ENABLE_BASE_MAINNET_RECEIPT_INDEXER=true

# Base Sepolia (chain ID 84532, ETH gas token)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_EXPLORER_URL=https://sepolia.basescan.org
AAE_ENABLE_BASE_SEPOLIA_RECEIPT_INDEXER=false

# Ethereum mainnet (chain ID 1, ETH gas token).
ETHEREUM_RPC_URL=
ETHEREUM_EXPLORER_URL=https://etherscan.io
AAE_ENABLE_ETHEREUM_MAINNET_RECEIPT_INDEXER=false
AAE_ENABLE_ETHEREUM_MAINNET_PAID_RAILS=false

# Ethereum Sepolia (chain ID 11155111, ETH gas token).
ETHEREUM_SEPOLIA_RPC_URL=
ETHEREUM_SEPOLIA_EXPLORER_URL=https://sepolia.etherscan.io
AAE_ENABLE_ETHEREUM_SEPOLIA_RECEIPT_INDEXER=false

# Monad mainnet readiness (chain ID 143, MON gas token). Do not enable paid
# mainnet writes without a named signer, cap, receipts, addresses, and rollback.
MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz
MONAD_MAINNET_EXPLORER_URL=https://monadexplorer.com
AAE_ENABLE_MONAD_MAINNET_RECEIPT_INDEXER=true
AAE_ENABLE_MONAD_MAINNET_PAID_RAILS=true

# Monad Testnet (chain ID 10143), only used when AAE_ACTIVE_CHAIN=monad-testnet
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_TESTNET_EXPLORER_URL=https://testnet.monadexplorer.com
AAE_ENABLE_MONAD_TESTNET_RECEIPT_INDEXER=false

# Robinhood Chain mainnet (chain ID 4663, ETH gas token). Native ETH direct
# wallet escrow is the initial supported path; do not enable paid rails until
# native escrow contracts are deployed, verified, indexed, and explicitly approved.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com/
ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com
AAE_ENABLE_ROBINHOOD_MAINNET_RECEIPT_INDEXER=false
AAE_ENABLE_ROBINHOOD_MAINNET_PAID_RAILS=false

# Robinhood Chain Testnet (chain ID 46630, ETH gas token).
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com/
ROBINHOOD_TESTNET_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
AAE_ENABLE_ROBINHOOD_TESTNET_RECEIPT_INDEXER=false

# Background workers. In production, run `npm run worker` as a separate process
# and set AAE_API_START_SCHEDULER=false on API containers if the worker is active.
AAE_API_START_SCHEDULER=true
AAE_WORKER_SCHEDULER_INTERVAL_MS=60000
AAE_ENABLE_CHAIN_INDEXER=false
AAE_CHAIN_INDEXER_INTERVAL_MS=30000
AAE_CHAIN_INDEXER_BATCH_BLOCKS=2000
# Optional safe backfill starts. Leave blank to begin at the latest finalized block.
AAE_BASE_INDEXER_START_BLOCK=
AAE_BASE_SEPOLIA_INDEXER_START_BLOCK=
AAE_ETHEREUM_INDEXER_START_BLOCK=
AAE_ETHEREUM_SEPOLIA_INDEXER_START_BLOCK=
AAE_MONAD_INDEXER_START_BLOCK=
AAE_MONAD_TESTNET_INDEXER_START_BLOCK=
AAE_ROBINHOOD_INDEXER_START_BLOCK=
AAE_ROBINHOOD_TESTNET_INDEXER_START_BLOCK=

# Platform policy version (matches effective date in legal policy)
POLICY_VERSION=2026-03-23

# Platform fee (basis points — 170 = 1.7%)
PLATFORM_FEE_BPS=170

# px402 dry-run policy. No live payment, signing, PRXVT note, or paid retry is enabled.
PX402_ENDPOINT_ALLOWLIST=http://localhost,http://127.0.0.1
PX402_ALLOWED_NETWORKS=base-sepolia
PX402_MAX_PROBE_USD=0.25
PX402_ALLOW_PLAIN_X402_FALLBACK=false

# x402 launch rail policy. Coinbase CDP is the default provider adapter.
# All execution flags default off; set caps/allowlists before any live exercise.
X402_PROVIDER=coinbase-cdp
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
X402_ALLOWED_NETWORKS=eip155:84532
X402_ENDPOINT_ALLOWLIST=http://localhost,http://127.0.0.1
X402_MAX_PAYMENT_USD=0
X402_MAX_RETRY_COUNT=1
AAE_ENABLE_X402_SELLER=false
AAE_ENABLE_X402_BUYER=false
AAE_ENABLE_X402_MAINNET=false
# Monad mainnet x402/px402 additionally requires AAE_ENABLE_MONAD_MAINNET_PAID_RAILS=true
# and X402_ALLOWED_NETWORKS to include eip155:143.
# Seller resource protection, used only when AAE_ENABLE_X402_SELLER=true.
X402_SELLER_RESOURCE_IDS=agent-resource
X402_SELLER_NETWORK=eip155:84532
X402_SELLER_PRICE_USD=0.01
# X402_SELLER_PAY_TO=0x...
# X402_CDP_API_KEY=

# Agentic stablecoin acceptance readiness. These are example-only and disabled
# by default; Visa/Mastercard provider URLs require separate account/API setup.
AAE_ENABLE_VISA_AGENTIC_PAYMENTS=false
AAE_ENABLE_MASTERCARD_AP4M=false
AAE_ENABLE_MAINNET_STABLECOIN_ACCEPTANCE=false
VISA_AGENTIC_PROVIDER_URL=
MASTERCARD_AP4M_PROVIDER_URL=
STABLECOIN_ACCEPTANCE_ALLOWED_NETWORKS=eip155:84532
STABLECOIN_ACCEPTANCE_ALLOWED_TOKENS=USDC
STABLECOIN_ACCEPTANCE_MAX_USD=0

# Contract-bound workspace evidence providers. GitHub credentials are optional
# for local tests; without GITHUB_TOKEN, provider responses stay mock/local-only.
GITLAWB_PUBLIC_NODE_URL=https://node.gitlawb.com
# AAE_ENABLE_LIVE_GITLAWB_WORKSPACES=false
# GITLAWB_RUNTIME_DIR=/app/.gitlawb-aae-live
# GITLAWB_IDENTITY_DIR=/app/.gitlawb-aae-live
# GITLAWB_CONFIG_FILE=/app/.gitlawb-aae-live/config.env
# GITLAWB_WEBHOOK_SECRET_FILE=/app/.gitlawb-aae-live/webhook-secret
# AAE_PUBLIC_WEBHOOK_BASE_URL=https://aethermarket.xyz
# GITHUB_TOKEN=
# AAE_ENABLE_WORKSPACE_CONTRACT_TESTS=false

# Manual receipt ingestion is for local/pre-wallet testing only.
# Leave false in production unless a trusted verifier/indexer controls the writer.
ALLOW_SELF_ATTESTED_SETTLEMENT_RECEIPTS=false
SETTLEMENT_TOKEN_DECIMALS=6

# Contract addresses for the active chain (populated after deployment)
ESCROW_FACTORY_ADDRESS=0xDD6b30B6A5Cd2fA2333e4FE4ae2Ba8249c56Cfa2
ERC8183_FACTORY_ADDRESS=
ERC8183_JOB_FACTORY_ADDRESS=
ERC8183_PAYMENT_TOKEN_ADDRESS=
ERC8183_ESCROW_IMPLEMENTATION_ADDRESS=
JOB_ESCROW_IMPL_ADDRESS=0x99562bDbE548A36Da13528B299547D49d36C0b14
AGENT_REGISTRY_ADDRESS=0xb06b466E26aB7A604DA94d899b2A93c9000adcBb
FEE_COLLECTOR_ADDRESS=0xE3F330Ac8cc5f9BAd131441f454Bd927e09114E3

# Base mainnet public contract/token wiring.
AAE_BASE_ESCROW_FACTORY_ADDRESS=0xDD6b30B6A5Cd2fA2333e4FE4ae2Ba8249c56Cfa2
AAE_BASE_NATIVE_ETH_ESCROW_FACTORY_ADDRESS=0x1d75bA6A9cF788742a4223408130129796fB6862
AAE_BASE_AGENT_REGISTRY_ADDRESS=0xb06b466E26aB7A604DA94d899b2A93c9000adcBb
AAE_BASE_FEE_COLLECTOR_ADDRESS=0xE3F330Ac8cc5f9BAd131441f454Bd927e09114E3
AAE_BASE_JOB_ESCROW_IMPL_ADDRESS=0x99562bDbE548A36Da13528B299547D49d36C0b14
AAE_BASE_USDC_TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Ethereum mainnet public contract/token wiring. Fill only after verified deployment.
AAE_ETHEREUM_ESCROW_FACTORY_ADDRESS=
AAE_ETHEREUM_NATIVE_ETH_ESCROW_FACTORY_ADDRESS=
AAE_ETHEREUM_AGENT_REGISTRY_ADDRESS=
AAE_ETHEREUM_FEE_COLLECTOR_ADDRESS=
AAE_ETHEREUM_JOB_ESCROW_IMPL_ADDRESS=
AAE_ETHEREUM_USDC_TOKEN_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48

# Ethereum Sepolia public contract/token wiring. Fill after staging deployment.
AAE_ETHEREUM_SEPOLIA_ESCROW_FACTORY_ADDRESS=
AAE_ETHEREUM_SEPOLIA_NATIVE_ETH_ESCROW_FACTORY_ADDRESS=
AAE_ETHEREUM_SEPOLIA_AGENT_REGISTRY_ADDRESS=
AAE_ETHEREUM_SEPOLIA_FEE_COLLECTOR_ADDRESS=
AAE_ETHEREUM_SEPOLIA_JOB_ESCROW_IMPL_ADDRESS=
AAE_ETHEREUM_SEPOLIA_USDC_TOKEN_ADDRESS=

# Monad mainnet public contract wiring. Native MON is enabled; ERC20 USDC is
# intentionally blank until a real Monad USDC contract is selected.
AAE_MONAD_ESCROW_FACTORY_ADDRESS=0x06e34Dc1b0fAc4BF08cD98897987394Df8D39B27
AAE_MONAD_NATIVE_ETH_ESCROW_FACTORY_ADDRESS=0x603873E4dc5dC461af5c7569C3312691a1c6d0cC
AAE_MONAD_AGENT_REGISTRY_ADDRESS=0x31Bc7b876940B5a4Ba21a6c9c66f15c6F383F63B
AAE_MONAD_FEE_COLLECTOR_ADDRESS=0xf399dE5431316ffd51B5E2F87055541A7Ed12383
AAE_MONAD_JOB_ESCROW_IMPL_ADDRESS=0x6D3A0071e61DE8f94013fbBAbB16564F3F4D1acD
AAE_MONAD_USDC_TOKEN_ADDRESS=

# Robinhood Chain public contract wiring. Native ETH direct wallet escrow is
# the only intended Robinhood production rail until ERC20/x402 provider support
# is separately verified, gated, tested, and documented.
AAE_ROBINHOOD_ESCROW_FACTORY_ADDRESS=
AAE_ROBINHOOD_NATIVE_ETH_ESCROW_FACTORY_ADDRESS=
AAE_ROBINHOOD_AGENT_REGISTRY_ADDRESS=
AAE_ROBINHOOD_FEE_COLLECTOR_ADDRESS=
AAE_ROBINHOOD_JOB_ESCROW_IMPL_ADDRESS=
AAE_ROBINHOOD_USDC_TOKEN_ADDRESS=
AAE_ROBINHOOD_WETH_TOKEN_ADDRESS=

# Robinhood Chain Testnet public contract wiring.
AAE_ROBINHOOD_TESTNET_ESCROW_FACTORY_ADDRESS=
AAE_ROBINHOOD_TESTNET_NATIVE_ETH_ESCROW_FACTORY_ADDRESS=
AAE_ROBINHOOD_TESTNET_AGENT_REGISTRY_ADDRESS=
AAE_ROBINHOOD_TESTNET_FEE_COLLECTOR_ADDRESS=
AAE_ROBINHOOD_TESTNET_JOB_ESCROW_IMPL_ADDRESS=
AAE_ROBINHOOD_TESTNET_USDC_TOKEN_ADDRESS=
AAE_ROBINHOOD_TESTNET_WETH_TOKEN_ADDRESS=

# Optional sandbox smoke wiring belongs in a local, uncommitted env override.
