# Aether Agent Exchange — Frontend Environment Variables
# Copy to .env and fill in deployed contract addresses.

# Active wallet/settlement chain. Supported: base, base-sepolia, ethereum, ethereum-sepolia, monad, monad-testnet, robinhood, robinhood-testnet.
VITE_ACTIVE_CHAIN=base

# Base mainnet readiness (chain ID 8453, ETH gas token)
VITE_BASE_RPC_URL=https://mainnet.base.org
VITE_BASE_EXPLORER_URL=https://basescan.org

# Base Sepolia (chain ID 84532, ETH gas token)
VITE_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
VITE_BASE_SEPOLIA_EXPLORER_URL=https://sepolia.basescan.org

# Ethereum mainnet readiness (chain ID 1, ETH gas token). Leave blank to use the backend RPC proxy.
VITE_ETHEREUM_RPC_URL=
VITE_ETHEREUM_EXPLORER_URL=https://etherscan.io

# Ethereum Sepolia staging (chain ID 11155111, ETH gas token). Leave blank to use the backend RPC proxy.
VITE_ETHEREUM_SEPOLIA_RPC_URL=
VITE_ETHEREUM_SEPOLIA_EXPLORER_URL=https://sepolia.etherscan.io

# Monad mainnet readiness (chain ID 143, MON gas token)
VITE_MONAD_MAINNET_RPC_URL=
VITE_MONAD_MAINNET_EXPLORER_URL=https://monadexplorer.com

# Monad testnet override, only used when VITE_ACTIVE_CHAIN=monad-testnet
VITE_MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
VITE_MONAD_TESTNET_EXPLORER_URL=https://testnet.monadexplorer.com

# Robinhood Chain mainnet (chain ID 4663, ETH gas token). Initial production
# support is native ETH direct wallet escrow only after native factory config.
VITE_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com/
VITE_ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Robinhood Chain Testnet (chain ID 46630, ETH gas token)
VITE_ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com/
VITE_ROBINHOOD_TESTNET_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com

# EscrowFactory contract address on active/default chain (deployed via Foundry)
VITE_ESCROW_FACTORY_ADDRESS=0xDD6b30B6A5Cd2fA2333e4FE4ae2Ba8249c56Cfa2

# Native-token escrow factory for direct wallet ETH/MON payments on the active chain.
# Set to the NativeEthEscrowFactory deployment for the active chain.
VITE_NATIVE_ETH_ESCROW_FACTORY_ADDRESS=0x1d75bA6A9cF788742a4223408130129796fB6862

# ERC-8183 factory contract address on active chain, when deployed
VITE_ERC8183_FACTORY_ADDRESS=

# FeeCollector contract address on active chain
VITE_FEE_COLLECTOR_ADDRESS=0xE3F330Ac8cc5f9BAd131441f454Bd927e09114E3

# ERC20 token contract addresses used by Direct wallet escrow on the active chain.
VITE_USDC_TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
VITE_MON_TOKEN_ADDRESS=
VITE_WETH_TOKEN_ADDRESS=

# Base mainnet public contract/token wiring.
VITE_BASE_ESCROW_FACTORY_ADDRESS=0xDD6b30B6A5Cd2fA2333e4FE4ae2Ba8249c56Cfa2
VITE_BASE_NATIVE_ETH_ESCROW_FACTORY_ADDRESS=0x1d75bA6A9cF788742a4223408130129796fB6862
VITE_BASE_FEE_COLLECTOR_ADDRESS=0xE3F330Ac8cc5f9BAd131441f454Bd927e09114E3
VITE_BASE_AGENT_REGISTRY_ADDRESS=0xb06b466E26aB7A604DA94d899b2A93c9000adcBb
VITE_BASE_JOB_ESCROW_IMPL_ADDRESS=0x99562bDbE548A36Da13528B299547D49d36C0b14
VITE_BASE_USDC_TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Ethereum mainnet public contract/token wiring. Fill only after verified deployment.
VITE_ETHEREUM_ESCROW_FACTORY_ADDRESS=
VITE_ETHEREUM_NATIVE_ETH_ESCROW_FACTORY_ADDRESS=
VITE_ETHEREUM_FEE_COLLECTOR_ADDRESS=
VITE_ETHEREUM_AGENT_REGISTRY_ADDRESS=
VITE_ETHEREUM_JOB_ESCROW_IMPL_ADDRESS=
VITE_ETHEREUM_USDC_TOKEN_ADDRESS=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48

# Ethereum Sepolia public contract/token wiring. Fill after staging deployment.
VITE_ETHEREUM_SEPOLIA_ESCROW_FACTORY_ADDRESS=
VITE_ETHEREUM_SEPOLIA_NATIVE_ETH_ESCROW_FACTORY_ADDRESS=
VITE_ETHEREUM_SEPOLIA_FEE_COLLECTOR_ADDRESS=
VITE_ETHEREUM_SEPOLIA_AGENT_REGISTRY_ADDRESS=
VITE_ETHEREUM_SEPOLIA_JOB_ESCROW_IMPL_ADDRESS=
VITE_ETHEREUM_SEPOLIA_USDC_TOKEN_ADDRESS=

# Monad mainnet public contract wiring. Native MON is enabled; ERC20 USDC is
# intentionally blank until a real Monad USDC contract is selected.
VITE_MONAD_ESCROW_FACTORY_ADDRESS=0x06e34Dc1b0fAc4BF08cD98897987394Df8D39B27
VITE_MONAD_NATIVE_ETH_ESCROW_FACTORY_ADDRESS=0x603873E4dc5dC461af5c7569C3312691a1c6d0cC
VITE_MONAD_FEE_COLLECTOR_ADDRESS=0xf399dE5431316ffd51B5E2F87055541A7Ed12383
VITE_MONAD_AGENT_REGISTRY_ADDRESS=0x31Bc7b876940B5a4Ba21a6c9c66f15c6F383F63B
VITE_MONAD_JOB_ESCROW_IMPL_ADDRESS=0x6D3A0071e61DE8f94013fbBAbB16564F3F4D1acD
VITE_MONAD_USDC_TOKEN_ADDRESS=

# Robinhood Chain public contract wiring. Leave ERC20/token addresses blank
# unless ERC20 rails are separately verified, gated, tested, and documented.
VITE_ROBINHOOD_ESCROW_FACTORY_ADDRESS=
VITE_ROBINHOOD_NATIVE_ETH_ESCROW_FACTORY_ADDRESS=
VITE_ROBINHOOD_FEE_COLLECTOR_ADDRESS=
VITE_ROBINHOOD_AGENT_REGISTRY_ADDRESS=
VITE_ROBINHOOD_JOB_ESCROW_IMPL_ADDRESS=
VITE_ROBINHOOD_USDC_TOKEN_ADDRESS=
VITE_ROBINHOOD_WETH_TOKEN_ADDRESS=

# Robinhood Chain Testnet public contract wiring.
VITE_ROBINHOOD_TESTNET_ESCROW_FACTORY_ADDRESS=
VITE_ROBINHOOD_TESTNET_NATIVE_ETH_ESCROW_FACTORY_ADDRESS=
VITE_ROBINHOOD_TESTNET_FEE_COLLECTOR_ADDRESS=
VITE_ROBINHOOD_TESTNET_AGENT_REGISTRY_ADDRESS=
VITE_ROBINHOOD_TESTNET_JOB_ESCROW_IMPL_ADDRESS=
VITE_ROBINHOOD_TESTNET_USDC_TOKEN_ADDRESS=
VITE_ROBINHOOD_TESTNET_WETH_TOKEN_ADDRESS=

# WalletConnect v2 project ID
VITE_WALLETCONNECT_PROJECT_ID=

# AAE deployment wiring for the active chain (public addresses only)
VITE_AGENT_REGISTRY_ADDRESS=0xb06b466E26aB7A604DA94d899b2A93c9000adcBb
VITE_JOB_ESCROW_IMPL_ADDRESS=0x99562bDbE548A36Da13528B299547D49d36C0b14
